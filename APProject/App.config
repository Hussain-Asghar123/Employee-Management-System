<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>
  <connectionStrings>
    <!--
      PostgreSQL connection string.
      Update Host, Port, Database, Username and Password to match your setup.
      Default PostgreSQL port is 5432.
    -->
    <add name="PostgresDB"
         connectionString="Host=localhost;Port=5432;Database=shahdb;Username=postgres;Password=Malik@786;Pooling=true;"
         providerName="Npgsql" />
  </connectionStrings>
</configuration>
